{
  "name": "@doeixd/csv-utils",
  "version": "3.0.0",
  "files": [
    "dist",
    "src",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "license": "MIT",
  "keywords": [
    "csv",
    "tsv",
    "parser",
    "transform",
    "utils",
    "csv-parser",
    "csv-transformer",
    "csv-writer",
    "csv-utils",
    "csv-utilities",
    "data-processing",
    "data-manipulation",
    "data-analysis",
    "etl",
    "data-pipeline",
    "array-of-objects",
    "object-array",
    "tabular-data",
    "delimited-files",
    "structured-data",
    "data-import",
    "data-export",
    "file-parser",
    "batch-processing",
    "streaming",
    "functional-programming",
    "data-transformation",
    "filter",
    "map",
    "reduce",
    "aggregate",
    "sort",
    "group",
    "pivot",
    "join",
    "merge",
    "validate",
    "schema-validation",
    "type-casting",
    "custom-casting",
    "header-mapping",
    "column-mapping",
    "data-cleaning",
    "data-wrangling",
    "linq",
    "pandas",
    "polars",
    "dplyr",
    "dataframe",
    "dataset",
    "table",
    "spreadsheet",
    "excel",
    "json",
    "xml",
    "database",
    "sql",
    "query",
    "fast",
    "performance",
    "memory-efficient",
    "typescript",
    "javascript",
    "node",
    "browser",
    "esm",
    "commonjs",
    "npm-package",
    "utility-library",
    "data-tools",
    "file-processing",
    "text-processing",
    "pridepack"
  ],
  "devDependencies": {
    "pridepack": "2.6.4",
    "standard-version": "^9.5.0",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vite-plus": "^1.6.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "release": "standard-version && git push --follow-tags origin main",
    "release:patch": "npm version patch && git push --follow-tags origin main",
    "release:minor": "npm version minor && git push --follow-tags origin main",
    "release:major": "npm version major && git push --follow-tags origin main",
    "prepublishOnly": "npm test && npm run test:types && npm run clean",
    "build": "pridepack build",
    "type-check": "pridepack check",
    "clean": "pridepack clean",
    "watch": "pridepack watch",
    "start": "pridepack start",
    "dev": "pridepack dev",
    "test": "vitest --run",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target es2020 --module esnext --moduleResolution bundler --types node --esModuleInterop test/public-types.test-d.ts",
    "postbuild": "node scripts/write-esm-package.cjs",
    "test:package": "node scripts/smoke-package.cjs && node --conditions=development scripts/smoke-package.cjs && npm run test:package:types",
    "prepack": "npm run build && npm run test:package",
    "test:package:types": "tsc --noEmit --strict --target es2020 --module nodenext --moduleResolution nodenext --types node --esModuleInterop test/package-consumer.mts test/package-consumer.cts && tsc --noEmit --strict --target es2020 --module nodenext --moduleResolution nodenext --types node --esModuleInterop --customConditions development test/package-consumer.mts test/package-consumer.cts"
  },
  "private": false,
  "description": "Utilities for csv files / arrays of objects",
  "repository": {
    "url": "git+https://github.com/doeixd/csv-utils.git",
    "type": "git"
  },
  "homepage": "https://github.com/doeixd/csv-utils#readme",
  "bugs": {
    "url": "https://github.com/doeixd/csv-utils/issues"
  },
  "author": "Patrick Glenn",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/node": "^22.20.5",
    "csv": "^6.6.4",
    "csv-parse": "^7.0.3",
    "fastest-levenshtein": "^1.0.16"
  },
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/production/index.js",
  "module": "./dist/esm/production/index.js",
  "exports": {
    ".": {
      "development": {
        "import": {
          "types": "./dist/types/esm/index.d.ts",
          "default": "./dist/esm/development/index.js"
        },
        "require": {
          "types": "./dist/types/index.d.ts",
          "default": "./dist/cjs/development/index.js"
        }
      },
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/esm/production/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/production/index.js"
      }
    },
    "./headers": {
      "development": {
        "import": {
          "types": "./dist/types/esm/headers.d.ts",
          "default": "./dist/esm/development/headers.js"
        },
        "require": {
          "types": "./dist/types/headers.d.ts",
          "default": "./dist/cjs/development/headers.js"
        }
      },
      "import": {
        "types": "./dist/types/esm/headers.d.ts",
        "default": "./dist/esm/production/headers.js"
      },
      "require": {
        "types": "./dist/types/headers.d.ts",
        "default": "./dist/cjs/production/headers.js"
      }
    },
    "./standalone": {
      "development": {
        "import": {
          "types": "./dist/types/esm/standalone.d.ts",
          "default": "./dist/esm/development/standalone.js"
        },
        "require": {
          "types": "./dist/types/standalone.d.ts",
          "default": "./dist/cjs/development/standalone.js"
        }
      },
      "import": {
        "types": "./dist/types/esm/standalone.d.ts",
        "default": "./dist/esm/production/standalone.js"
      },
      "require": {
        "types": "./dist/types/standalone.d.ts",
        "default": "./dist/cjs/production/standalone.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "headers": [
        "./dist/types/headers.d.ts"
      ],
      "standalone": [
        "./dist/types/standalone.d.ts"
      ]
    }
  }
}
